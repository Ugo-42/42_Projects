server {
	listen 80;
	server_name _;
	# return 301 https://$http_host${GATEWAY_PORT_HTTPS}$request_uri;
	return 301 https://$host:$GATEWAY_PORT_HTTPS$request_uri;
}

server {
	listen 443 ssl;
	server_name _;

	ssl_certificate     /etc/nginx/ssl/transcendence.crt;
	ssl_certificate_key /etc/nginx/ssl/transcendence.key;

	location / {
		proxy_pass http://${FRONTEND_HOST}:${FRONTEND_PORT};
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
	}

	location /api/socket/ {
		proxy_pass http://${SOCKET_SERVICE_HOST}:${SOCKET_SERVICE_PORT}/;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	}

	location /api/auth/ {
		proxy_pass http://${USER_SERVICE_HOST}:${USER_SERVICE_PORT}/;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	}

	location /api/user/ {
		proxy_pass http://${USER_SERVICE_HOST}:${USER_SERVICE_PORT}/;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	}

	location /api/game/ {
		proxy_pass http://${GAME_SERVICE_HOST}:${GAME_SERVICE_PORT}/;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	}

	location /socket.io/ {
		proxy_pass http://${SOCKET_SERVICE_HOST}:${SOCKET_SERVICE_PORT}/socket.io/;
		proxy_http_version 1.1;

		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";

		proxy_set_header Host $host;
		proxy_cache_bypass $http_upgrade;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	}

	location /game-socket.io/ {
		proxy_pass http://${GAME_SERVICE_HOST}:${GAME_SERVICE_PORT}/game-socket.io/;

		proxy_http_version 1.1;

		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";

		proxy_set_header Host $host;
		proxy_cache_bypass $http_upgrade;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	}
}
